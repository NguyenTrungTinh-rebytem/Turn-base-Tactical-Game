build game.exe: CXX_EXECUTABLE_LINKER__game_ CMakeFiles/game.dir/src/core/AttackCommand.cpp.obj CMakeFiles/game.dir/src/core/CommandStack.cpp.obj CMakeFiles/game.dir/src/core/GameEngine.cpp.obj CMakeFiles/game.dir/src/core/GameStateMachine.cpp.obj CMakeFiles/game.dir/src/core/UseItemCommand.cpp.obj CMakeFiles/game.dir/src/core/UseSkillCommand.cpp.obj CMakeFiles/game.dir/src/data/GameData.cpp.obj CMakeFiles/game.dir/src/dsa/CombatObserver.cpp.obj CMakeFiles/game.dir/src/dsa/StatusEffect.cpp.obj CMakeFiles/game.dir/src/dsa/TurnManager.cpp.obj CMakeFiles/game.dir/src/entities/Boss.cpp.obj CMakeFiles/game.dir/src/entities/Character.cpp.obj CMakeFiles/game.dir/src/entities/Enemy.cpp.obj CMakeFiles/game.dir/src/entities/Player.cpp.obj CMakeFiles/game.dir/src/graphics/BattleMap.cpp.obj CMakeFiles/game.dir/src/graphics/BattleUi.cpp.obj CMakeFiles/game.dir/src/graphics/CombatantView.cpp.obj CMakeFiles/game.dir/src/graphics/Herocreatescreen.cpp.obj CMakeFiles/game.dir/src/graphics/SpriteAnimation.cpp.obj CMakeFiles/game.dir/src/graphics/StartMenu.cpp.obj CMakeFiles/game.dir/src/graphics/main_map_test.cpp.obj CMakeFiles/game.dir/src/graphics/main_sprite_test.cpp.obj CMakeFiles/game.dir/src/main.cpp.obj | C$:/msys64/ucrt64/lib/libraylib.dll.a
  LINK_LIBRARIES = C:/msys64/ucrt64/lib/libraylib.dll.a  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32
  OBJECT_DIR = CMakeFiles\game.dir
  POST_BUILD = C:\Windows\system32\cmd.exe /C "cd /D D:\Turn-base-Tactical-Game\build && D:\mingw64\bin\cmake.exe -E copy_directory D:/Turn-base-Tactical-Game/data D:/Turn-base-Tactical-Game/build/data && D:\mingw64\bin\cmake.exe -E copy_directory D:/Turn-base-Tactical-Game/assets D:/Turn-base-Tactical-Game/build/assets"
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = CMakeFiles\game.dir\
  TARGET_FILE = game.exe
  TARGET_IMPLIB = libgame.dll.a
  TARGET_PDB = game.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\game.dir


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\Turn-base-Tactical-Game\build && D:\mingw64\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\Turn-base-Tactical-Game\build && D:\mingw64\bin\cmake.exe --regenerate-during-build -SD:\Turn-base-Tactical-Game -BD:\Turn-base-Tactical-Game\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

